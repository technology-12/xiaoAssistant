<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 晓助手·留白工作室 浅色 Token（docs/GUI_VISUAL_DIRECTION_V2.md） -->
    <Color x:Key="ColorSurfaceMain">#FAFBF7</Color>
    <Color x:Key="ColorSurfaceSidebar">#EFF3EC</Color>
    <Color x:Key="ColorSurfaceElevated">#FFFFFF</Color>
    <Color x:Key="ColorTextPrimary">#28392F</Color>
    <Color x:Key="ColorTextSecondary">#616E63</Color>
    <Color x:Key="ColorBorderSubtle">#DFE6DA</Color>
    <Color x:Key="ColorSurfaceSelected">#E7EEE2</Color>
    <Color x:Key="ColorAccent">#416E60</Color>
    <Color x:Key="ColorAccentSoft">#E6F0E8</Color>
    <Color x:Key="ColorActionPrimary">#365E50</Color>
    <Color x:Key="ColorActionForeground">#FFFFFF</Color>
    <Color x:Key="ColorError">#B42318</Color>
    <Color x:Key="ColorSuccess">#3E6B4F</Color>

    <SolidColorBrush x:Key="BrushSurfaceMain" Color="{StaticResource ColorSurfaceMain}" />
    <SolidColorBrush x:Key="BrushSurfaceSidebar" Color="{StaticResource ColorSurfaceSidebar}" />
    <SolidColorBrush x:Key="BrushSurfaceElevated" Color="{StaticResource ColorSurfaceElevated}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushSurfaceSelected" Color="{StaticResource ColorSurfaceSelected}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushActionPrimary" Color="{StaticResource ColorActionPrimary}" />
    <SolidColorBrush x:Key="BrushActionForeground" Color="{StaticResource ColorActionForeground}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushHoverSubtle" Color="#F0F4EB" />
    <SolidColorBrush x:Key="BrushInputBorder" Color="#CCD8C7" />
    <SolidColorBrush x:Key="BrushActionHover" Color="#487361" />

    <!-- 字体：Segoe UI，中文回退 Microsoft YaHei -->
    <FontFamily x:Key="FontUi">Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Microsoft YaHei</FontFamily>

    <sys:Double x:Key="SizeFontTitle">36</sys:Double>
    <sys:Double x:Key="SizeFontSection">20</sys:Double>
    <sys:Double x:Key="SizeFontBody">14</sys:Double>
    <sys:Double x:Key="SizeFontSecondary">12</sys:Double>

    <!-- 间距：横向 24/32，纵向 12/20/32，基础 4 -->
    <Thickness x:Key="PadCard">16,12,16,12</Thickness>
    <Thickness x:Key="PadInput">14,12,14,12</Thickness>

    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusInput">18</CornerRadius>

    <!-- 内容最大宽度与侧栏宽度 -->
    <sys:Double x:Key="ContentMaxWidth">720</sys:Double>
    <sys:Double x:Key="SidebarWidth">216</sys:Double>
    <sys:Double x:Key="TopBarHeight">60</sys:Double>
</ResourceDictionary>
