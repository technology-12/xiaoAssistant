<Window x:Class="WorkAssistant.Desktop.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认文件操作" Width="520" Height="460" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BrushSurfaceMain}" FontFamily="{StaticResource FontUi}" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Path Data="{StaticResource Icon.Alert}" Stroke="{StaticResource BrushAccent}"
                          StrokeThickness="1.6" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontSize="19" FontWeight="Medium" Margin="10,0,0,0"
                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />
                <Border Background="{StaticResource BrushSurfaceSelected}" BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                    <TextBlock Text="操作明细（逐项执行，任何一项失败都会停止并提示复核）" Style="{StaticResource StudioCaption}" />
                </Border>
                <ItemsControl x:Name="OperationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource FontMono}"
                                       FontSize="12" Margin="2,3" Foreground="{StaticResource BrushTextPrimary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                Background="{StaticResource BrushSurfaceElevated}" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource StudioButton}" Content="取消操作" IsCancel="True"
                        MinWidth="96" Margin="0,0,10,0" Click="OnDeny" />
                <Button Style="{StaticResource StudioPrimary}" Content="同意执行" MinWidth="110" Click="OnAllow"
                        AutomationProperties.Name="同意执行文件操作" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
