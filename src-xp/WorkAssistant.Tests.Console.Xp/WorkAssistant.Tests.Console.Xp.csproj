<Project Sdk="Microsoft.NET.Sdk">
  <!-- XP 线测试跑批：链接主线全部测试源码，net40 目标。
       在 .NET 4.8 运行时上执行用于功能同构验证；真实 XP 实机证据另按验收矩阵采集。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WorkAssistant.Tests.Console</RootNamespace>
    <AssemblyName>WorkAssistant.Tests.Console</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\tests\WorkAssistant.Tests.Console\*.cs"
             Exclude="..\..\tests\WorkAssistant.Tests.Console\XpCompression.cs;..\..\tests\WorkAssistant.Tests.Console\Program.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\WorkAssistant.Tests.Console\XpCompression.Xp.cs" Link="XpCompression.cs" />
    <Compile Include="..\WorkAssistant.Tests.Console\Program.Xp.cs" Link="Program.cs" />
    <Compile Include="..\WorkAssistant.Tests.Console\XpCompatTests.Xp.cs" Link="XpCompatTests.cs" />
    <Compile Include="..\WorkAssistant.Tests.Console\XpEditRecoveryTests.Xp.cs" Link="XpEditRecoveryTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkAssistant.Core.Xp\WorkAssistant.Core.Xp.csproj" />
    <ProjectReference Include="..\WorkAssistant.Infrastructure.Xp\WorkAssistant.Infrastructure.Xp.csproj" />
    <ProjectReference Include="..\WorkAssistant.Tools.Xp\WorkAssistant.Tools.Xp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
