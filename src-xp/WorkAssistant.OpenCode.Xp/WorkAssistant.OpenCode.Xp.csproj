<Project Sdk="Microsoft.NET.Sdk">
  <!-- XP 线 OpenCode 协议层：链接主线源码；OpenCodeConnection 使用 XP 变体（基线强制本地内核）。
       HttpClient 由兼容层垫片提供（HttpWebRequest 传输）。 -->
  <PropertyGroup>
    <RootNamespace>WorkAssistant.OpenCode</RootNamespace>
    <AssemblyName>WorkAssistant.OpenCode</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\WorkAssistant.OpenCode\*.cs"
             Exclude="..\..\src\WorkAssistant.OpenCode\OpenCodeConnection.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\WorkAssistant.OpenCode\OpenCodeConnection.Xp.cs" Link="OpenCodeConnection.Xp.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WorkAssistant.Core.Xp\WorkAssistant.Core.Xp.csproj" />
    <ProjectReference Include="..\WorkAssistant.Infrastructure.Xp\WorkAssistant.Infrastructure.Xp.csproj" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
