<!-- XP 变体（替换 src/WorkAssistant.Desktop/MainWindow.xaml）：
     VirtualizingPanel.ScrollUnit/IsVirtualizing 为 WPF 4.5 属性；4.0 下 CanContentScroll
     已启用虚拟化，保留 Recycling 模式。其余布局与主线一致。 -->
<Window x:Class="WorkAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkAssistant.Desktop"
        xmlns:p="clr-namespace:WorkAssistant.Desktop.Presentation"
        Title="晓助手" Icon="Assets/AppIcon.ico" Height="780" Width="1180" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushSurfaceMain}"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:ConversationTemplateSelector x:Key="ConversationSelector" />

        <!-- 用户消息：浅底右对齐有限宽度 -->
        <DataTemplate x:Key="TplUser">
            <Grid Margin="0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" MaxWidth="560">
                    <Border Background="{StaticResource BrushSurfaceSelected}"
                            BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                            CornerRadius="12" Padding="14,10">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   FontSize="15" LineHeight="26"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Row="1" HorizontalAlignment="Right" Margin="4,3,2,0"
                           Style="{StaticResource TextSecondary}" Text="{Binding TimeText}" />
            </Grid>
        </DataTemplate>

        <!-- 助手消息：无外框正文 + 文件卡 -->
        <DataTemplate x:Key="TplAssistant">
            <StackPanel Margin="0,12,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Path Data="{StaticResource Icon.BrandStar}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" Width="18" Height="18" />
                    <TextBlock Text="晓助手" FontSize="13" FontWeight="Medium" Margin="9,0,0,0" Foreground="{StaticResource BrushTextPrimary}" />
                </StackPanel>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="15" LineHeight="27"
                           Foreground="{StaticResource BrushTextPrimary}" />
                <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,18,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,10" HorizontalAlignment="Left" Width="292" Padding="16"
                                    CornerRadius="12" Background="{StaticResource BrushSurfaceElevated}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="{Binding IconKey, Converter={x:Static local:IconKeyToGeometryConverter.Instance}}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" Width="20" Height="20" />
                                    <Button Grid.Column="1" Style="{StaticResource StudioButton}" Padding="2,3" HorizontalContentAlignment="Left"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.OpenArtifactCommand}" CommandParameter="{Binding}"
                                            ToolTip="点击文件名，在本地应用中打开">
                                        <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontWeight="Medium" Foreground="{StaticResource BrushAccent}" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TypeText}" Style="{StaticResource StudioCaption}" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Path}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,12" />
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource StudioButton}" Content="预览" Click="OnPreviewArtifact" CommandParameter="{Binding}" Padding="10,6" MinHeight="34" ToolTip="只读预览文件文字或表格，不执行文档内容" />
                                        <Button Style="{StaticResource StudioButton}" Content="打开文件" Padding="10,6" MinHeight="34" Margin="4,0,0,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.OpenArtifactCommand}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource StudioButton}" Content="详情" Padding="10,6" MinHeight="34" Margin="4,0,0,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ShowArtifactCommand}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- 执行步骤组：折叠面板 -->
        <DataTemplate x:Key="TplExecution">
            <Expander Style="{StaticResource StepsExpander}" IsExpanded="{Binding IsExpanded, Mode=OneWay}" Margin="0,8,0,12">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.ChevronRight}" Stroke="{StaticResource BrushTextSecondary}"
                              StrokeThickness="1.6" Width="12" Height="12" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Converter={x:Static local:ExpandRotateConverter.Instance}, Mode=OneWay}" />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="{Binding GroupTitle}" Margin="8,0,0,0"
                                   Style="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel Margin="0,5">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource BrushError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Text}" Margin="10,0,0,0"
                                           FontSize="13" TextWrapping="Wrap" MaxWidth="360" Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ToolName}" Margin="8,0,0,0"
                                           Style="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TimeText}" Margin="8,0,0,0"
                                           Style="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <!-- 失败信息：原因 + 下一动作 + 可展开错误码 -->
        <DataTemplate x:Key="TplError">
            <Border Background="#FAEDEB" BorderBrush="#E7C3BE" BorderThickness="1"
                    CornerRadius="12" Padding="14,12" Margin="0,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Alert}" Stroke="{StaticResource BrushError}"
                              StrokeThickness="1.6" Width="16" Height="16" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="10,0,0,0"
                                   FontSize="14" Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="26,10,0,0">
                        <Button Style="{StaticResource Btn}" Padding="10,5" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.RetryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Send}" Stroke="{StaticResource BrushAccent}"
                                      StrokeThickness="1.6" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding NextAction}" Margin="6,0,0,0" Foreground="{StaticResource BrushAccent}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Padding="10,5" Margin="4,0,0,0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ShowDiagnosticsCommand}">
                            <TextBlock Text="查看执行详情" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <Expander Style="{StaticResource StepsExpander}" Margin="26,6,0,0" Header="错误码">
                        <TextBlock Text="{Binding ErrorCode}" FontFamily="{StaticResource FontMono}"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TplQuestion">
            <Border Background="{StaticResource BrushSurfaceElevated}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,12,0,18" DataContext="{Binding QuestionCard}">
                <StackPanel>
                    <TextBlock Text="需要你确认" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="15" LineHeight="24" />
                    <Expander Header="查看具体内容" IsExpanded="{Binding ShowDetails, Mode=OneWay}" Margin="0,10,0,10" Visibility="{Binding Details, Converter={x:Static local:NonEmptyToVisConverter.Instance}}">
                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto" />
                    </Expander>
                    <ItemsControl ItemsSource="{Binding Options}" Margin="0,12,0,0" IsEnabled="{Binding IsPending}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource StudioButton}" BorderBrush="{StaticResource BrushInputBorder}" BorderThickness="1" Padding="14,10" Margin="0,0,8,8" MinHeight="42"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ChooseCommand}" CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="280" />
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="或填写自己的答案" IsExpanded="{Binding NeedsText, Mode=OneWay}" Visibility="{Binding AllowFreeText, Converter={x:Static local:BoolToVisConverter.Instance}}" IsEnabled="{Binding IsPending}"><StackPanel Margin="0,8,0,0">
                        <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="52" MaxHeight="120" MaxLength="4000" VerticalScrollBarVisibility="Auto" Style="{StaticResource InputBox}" AutomationProperties.Name="补充回答" />
                        <Button Content="提交回答并继续" Style="{StaticResource StudioPrimary}" Command="{Binding SubmitCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel></Expander>
                    <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="取消本次" Style="{StaticResource StudioButton}" Command="{Binding CancelCommand}" />
                        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource StudioCaption}" /></DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- 系统提示 -->
        <DataTemplate x:Key="TplNotice">
            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" Margin="0,8"
                       Style="{StaticResource TextSecondary}" />
        </DataTemplate>
        <DataTemplate x:Key="StudioComposer">
            <StackPanel>
                <Border x:Name="Composer" BorderBrush="{StaticResource BrushInputBorder}" BorderThickness="1" CornerRadius="22" Background="{StaticResource BrushSurfaceElevated}" Padding="20,18,16,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="TaskInput" Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" MaxHeight="130" FontSize="15"
                                PreviewKeyDown="OnTaskInputPreviewKeyDown" LostKeyboardFocus="OnTaskInputLostKeyboardFocus"
                                Style="{StaticResource InputMultiline}" IsEnabled="{Binding InputLocked, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                AutomationProperties.Name="任务描述" ToolTip="Enter 发送，Shift+Enter 换行；Ctrl+Enter 也可发送。运行中发送会加入队列。" />
                            <TextBlock x:Name="Placeholder" Text="描述你想完成的工作，剩下的交给我…" IsHitTestVisible="False" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Top">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=TaskInput}" Value="" />
                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TaskInput}" Value="False" />
                                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">                            <Button Style="{StaticResource StudioButton}" Padding="8,5" MinHeight="32" HorizontalAlignment="Left" Command="{Binding ChooseWorkspaceCommand}" Background="{StaticResource BrushSurfaceSelected}" ToolTip="{Binding WorkspacePath}">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource StudioIcon}" Width="13" Height="13" />
                                    <TextBlock Text="{Binding WorkspaceLabel}" FontSize="12" Margin="7,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" /></StackPanel>
                            </Button>
                                <Button Style="{StaticResource StudioButton}" Click="OnAttachFiles" Content="添加文件" MinHeight="32" Padding="10,5" Margin="6,0,0,0" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource StudioPrimary}" Command="{Binding SendCommand}" Width="36" Height="36" MinHeight="36" Padding="9" AutomationProperties.Name="发送任务" ToolTip="发送 · Enter（Shift+Enter 换行）"
                                Visibility="{Binding IsRunning, Converter={x:Static local:InverseBoolToVisConverter.Instance}}">
                                <Path Data="{StaticResource Icon.Send}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushActionForeground}" Width="17" Height="17" />
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource StudioPrimary}" Command="{Binding SendCommand}" Width="36" Height="36" MinHeight="36" Padding="10" IsEnabled="{Binding IsCancelling, Converter={x:Static local:InverseBoolConverter.Instance}}" AutomationProperties.Name="停止当前任务" ToolTip="停止当前任务"
                                Visibility="{Binding IsRunning, Converter={x:Static local:BoolToVisConverter.Instance}}">
                                <Path Data="{StaticResource Icon.Stop}" Fill="{StaticResource BrushActionForeground}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Margin="4,8,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding WorkspaceLocation}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource StudioButton}" Command="{Binding OpenWorkspaceCommand}" Content="打开目录" Padding="6,4" FontSize="11" ToolTip="在文件管理器中打开当前工作目录" />
                        <Button Style="{StaticResource StudioButton}" Command="{Binding OpenOutputDirectoryCommand}" Content="输出文件" Padding="6,4" FontSize="11" ToolTip="打开 output，文档直接保存在这里" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SendLockedReason}" Style="{StaticResource StudioCaption}" Margin="2,8,0,0" Visibility="{Binding SendLockedReason, Converter={x:Static local:NonEmptyToVisConverter.Instance}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="TaskInput" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Composer" Property="BorderBrush" Value="{StaticResource BrushAccent}" /></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="SidebarConversationButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,8" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource BrushSurfaceSelected}" /><Setter Property="Foreground" Value="{StaticResource BrushAccent}" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="SidebarConversationRow">
            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource SidebarConversationButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.LoadHistoryTaskCommand}" CommandParameter="{Binding}" ToolTip="{Binding Title}">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                </Button>
                <Button Grid.Column="1" Style="{StaticResource StudioButton}" Content="⋯" FontSize="17" Padding="3" MinHeight="32" Click="OnConversationMenu" ToolTip="重命名、移动或移除对话" AutomationProperties.Name="对话菜单" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewTaskCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource BrushSurfaceSidebar}" Width="260" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BrushBorderSubtle}"
                Visibility="{Binding SidebarCollapsed, Converter={x:Static local:InverseBoolToVisConverter.Instance}}">
            <DockPanel Margin="14,22,14,14">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,20">
                        <Image Source="Assets/AppIcon.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="晓助手应用标识" />
                        <StackPanel Margin="10,0,0,0"><TextBlock Text="晓助手" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="你的办公工作室" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" /></StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource StudioPrimary}" Command="{Binding NewTaskCommand}" HorizontalContentAlignment="Stretch" ToolTip="新建独立对话 · Ctrl+N">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushActionForeground}" Width="15" Height="15" />
                            <TextBlock Grid.Column="1" Text="新对话" Margin="10,0,0,0" /><TextBlock Grid.Column="2" Text="Ctrl N" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Grid Margin="0,10,0,8">
                        <TextBox Text="{Binding SidebarSearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" MinHeight="36" Padding="12,8" AutomationProperties.Name="搜索项目和对话" ToolTip="按项目名称、说明或对话标题搜索" />
                        <TextBlock Text="搜索项目和对话" Foreground="{StaticResource BrushTextSecondary}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SidebarSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource StudioButton}" Click="OnSkills" HorizontalContentAlignment="Left" MinHeight="38" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource Icon.BrandStar}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" /><TextBlock Text="技能工作室" Margin="10,0,0,0" /></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <Button Style="{StaticResource StudioButton}" Background="{StaticResource BrushSurfaceElevated}" BorderBrush="{StaticResource BrushBorderSubtle}" Padding="10" MinHeight="58" Command="{Binding ChooseWorkspaceCommand}" ToolTip="{Binding WorkspacePath}" HorizontalContentAlignment="Stretch">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding WorkspaceLabel}" TextTrimming="CharacterEllipsis" FontSize="12" /><TextBlock Text="当前工作目录" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" /></StackPanel>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource StudioButton}" Click="OnTaskCenter" Content="任务与成果" HorizontalContentAlignment="Left" MinHeight="36" Margin="0,6,0,0" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource StudioButton}" Command="{Binding OpenSettingsCommand}" Content="设置" HorizontalContentAlignment="Left" MinHeight="36" />
                                <Button Grid.Column="1" Style="{StaticResource StudioButton}" Content="⋯" Click="OnSidebarMore" Padding="3" MinHeight="32" ToolTip="版本、诊断与更新" AutomationProperties.Name="更多设置" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid Margin="8,8,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                            <TextBlock Text="项目" Style="{StaticResource StudioCaption}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource StudioButton}" Click="OnCreateProject" Padding="5" MinHeight="30" ToolTip="新建项目" AutomationProperties.Name="新建项目" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"><Path Data="{StaticResource Icon.Plus}" Style="{StaticResource StudioIcon}" Width="14" Height="14" /></Button>
                        </Grid>
                        <TextBlock Text="新建项目，把相关对话归在一起。" Style="{StaticResource StudioCaption}" Margin="10,4,8,8" Visibility="{Binding IsProjectListEmpty, Converter={x:Static local:BoolToVisConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Margin="0,2">
                                <Border CornerRadius="10"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource BrushSurfaceSelected}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource StudioButton}" Click="OnToggleProject" Padding="6" MinHeight="36" ToolTip="展开或折叠项目" AutomationProperties.Name="展开或折叠项目">
                                            <Path Data="{StaticResource Icon.ChevronRight}" RenderTransformOrigin="0.5,0.5"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource StudioIcon}"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource StudioButton}" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectProjectCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="4,9" ToolTip="{Binding WorkspaceRoot}">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource StudioIcon}" Width="16" Height="16" Stroke="{StaticResource BrushAccent}" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13" Margin="8,0,0,0" /></Grid>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource StudioButton}" Click="OnProjectMenu" Content="⋯" FontSize="17" Padding="3" MinHeight="32" ToolTip="编辑、打开目录或删除项目" AutomationProperties.Name="项目菜单" IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="20,2,0,6" Visibility="{Binding IsExpanded, Converter={x:Static local:BoolToVisConverter.Instance}}">
                                    <TextBlock Text="{Binding ConversationCount}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="10,3,0,3" />
                                    <ItemsControl ItemsSource="{Binding Conversations}" ItemTemplate="{StaticResource SidebarConversationRow}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="最近对话" Style="{StaticResource StudioCaption}" Margin="10,22,0,7" />
                        <TextBlock Text="还没有独立对话或匹配结果。" Style="{StaticResource StudioCaption}" Margin="10,4,8,8" Visibility="{Binding IsHistoryEmpty, Converter={x:Static local:BoolToVisConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding HistoryGroups}"><ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel><TextBlock Text="{Binding Header}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="10,10,0,4" /><ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource SidebarConversationRow}" /></StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="22,16,24,8" MinHeight="36">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource StudioButton}" Padding="8" Command="{Binding ToggleSidebarCommand}" ToolTip="收起或展开侧栏" AutomationProperties.Name="收起或展开侧栏">
                    <Path Data="{StaticResource Icon.PanelLeft}" Style="{StaticResource StudioIcon}" />
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" ClipToBounds="True">
                    <TextBlock Text="{Binding ContextTitle}" Style="{StaticResource StudioCaption}" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text=" / " Foreground="{StaticResource BrushBorderSubtle}" Margin="8,0" />
                    <TextBlock Text="{Binding SkillDisplay}" Style="{StaticResource StudioCaption}" MaxWidth="100" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="PermissionModeButton" Style="{StaticResource StudioButton}" Click="OnOpenPermissionMenu" Padding="10,8" MinHeight="44" Margin="0,0,8,0"
                    BorderBrush="{StaticResource BrushBorderSubtle}" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"
                    ToolTip="{Binding PermissionDescription}" AutomationProperties.Name="选择任务权限" AutomationProperties.HelpText="{Binding PermissionDescription}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PermissionDisplay}" FontSize="12" />
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource StudioIcon}" Width="10" Height="10" Margin="8,0,0,0" /></StackPanel>
                </Button>
                <CheckBox Content="只读分析" IsChecked="{Binding IsReadOnlyAnalysis}" VerticalContentAlignment="Center" MinHeight="44" Padding="5,0" Margin="0,0,12,0" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"
                    IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}"
                    ToolTip="只读取、提取和计算；不导出文件、不整理原文件。任务提交后模式固定。" AutomationProperties.Name="只读分析模式" />
                <Button Style="{StaticResource StudioButton}" Click="OnOpenModelMenu" Padding="12,8" BorderBrush="{StaticResource BrushBorderSubtle}" MinHeight="40" ToolTip="选择模型 · 切换后自动保存，下一任务生效" AutomationProperties.Name="选择模型">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ModelDisplay}" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource StudioIcon}" Width="10" Height="10" Margin="8,0,0,0" /></StackPanel>
                </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <!-- 首页：标题、输入与快捷入口共用对齐线，输入紧随标题。 -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasConversation, Converter={x:Static local:InverseBoolToVisConverter.Instance}}">
                    <Grid Margin="36,20,36,28" MaxWidth="700" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <StackPanel>
                            <StackPanel x:Name="HomeWelcomePanel" Margin="0,12,0,28">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Image Source="Assets/AppIcon.png" Width="54" Height="54" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Margin="14,5,0,0"><TextBlock Text="晓助手" FontSize="12" Foreground="{StaticResource BrushAccent}" /><TextBlock Text="给想法一点空间，给工作一个帮手。" Style="{StaticResource StudioCaption}" Margin="0,4,0,0" /></StackPanel></StackPanel>
                                <TextBlock Text="{Binding WelcomeTitle}" FontSize="34" FontWeight="SemiBold" LineHeight="48" TextWrapping="Wrap" Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding HomeSubtitle}" Style="{StaticResource StudioCaption}" FontSize="14" Margin="0,12,0,0" />
                            </StackPanel>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StudioComposer}" />
                            <StackPanel Orientation="Horizontal" Margin="2,12,0,0"><Path Data="{StaticResource Icon.Check}" Style="{StaticResource StudioIcon}" Width="12" Height="12" />
                                <TextBlock Text="仅访问已授权的工作目录" Style="{StaticResource StudioCaption}" Margin="7,0,0,0" /></StackPanel>
                            <TextBlock Text="灵感，从这里开始" Style="{StaticResource StudioCaption}" Margin="0,28,0,10" />
                            <ItemsControl ItemsSource="{Binding Suggestions}" HorizontalContentAlignment="Stretch">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource StudioCard}" Margin="0,0,12,12" Padding="20" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.FillSuggestionCommand}" CommandParameter="{Binding}" ToolTip="填入任务描述，不直接执行">
                                        <StackPanel><Border Background="{StaticResource BrushAccentSoft}" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,0,0,14"><Path Data="{Binding IconKey, Converter={x:Static local:IconKeyToGeometryConverter.Instance}}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" /></Border>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource StudioCaption}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <!-- 会话：虚拟化列表独立滚动，输入区固定。 -->
                <Grid Visibility="{Binding HasConversation, Converter={x:Static local:BoolToVisConverter.Instance}}" Margin="24,12,24,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid MaxWidth="720" Margin="10,0,10,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ConversationTitle}" FontSize="20" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource StudioButton}" Command="{Binding ShowDiagnosticsCommand}" Content="执行详情" FontSize="12" Margin="14,0,0,0" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="ConversationList" ItemsSource="{Binding Conversation}" ItemTemplateSelector="{StaticResource ConversationSelector}"
                        ItemContainerStyle="{StaticResource ConversationItem}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="12,0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" ScrollViewer.ScrollChanged="OnConversationScrollChanged"
                        VirtualizingStackPanel.VirtualizationMode="Recycling"
                        MaxWidth="720" />
                    <StackPanel Grid.Row="2" MaxWidth="700" Margin="10,14,10,0">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StudioCaption}" Margin="3,0,0,8" Visibility="{Binding StatusText, Converter={x:Static local:NonEmptyToVisConverter.Instance}}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StudioComposer}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="24,10,24,12">
                <TextBlock Text="{Binding ContextAttentionText}" ToolTip="{Binding ContextAttentionDescription}" Style="{StaticResource StudioCaption}" TextAlignment="Center" Margin="0,0,0,4" AutomationProperties.Name="上下文自动整理状态" />
                <TextBlock Text="{Binding FooterText}" Style="{StaticResource StudioCaption}" TextAlignment="Center" />
            </StackPanel>
            <!-- 详情覆盖主区而非继续挤压对话，窄窗口仍可使用。 -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#26000000" Visibility="{Binding IsDrawerOpen, Converter={x:Static local:BoolToVisConverter.Instance}}">
                <Grid><Button Background="Transparent" BorderThickness="0" Command="{Binding CloseDrawerCommand}" Focusable="False" AutomationProperties.Name="关闭文件详情" />
                    <Border Background="{StaticResource BrushSurfaceElevated}" Width="340" HorizontalAlignment="Right" Padding="24" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle" FocusManager.IsFocusScope="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                            <Grid><TextBlock Text="交付文件" FontSize="19" FontWeight="Medium" VerticalAlignment="Center" />
                                <Button x:Name="DrawerClose" Style="{StaticResource StudioButton}" HorizontalAlignment="Right" Command="{Binding CloseDrawerCommand}" Padding="8" AutomationProperties.Name="关闭文件详情" ToolTip="关闭详情 · Esc">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource StudioIcon}" /></Button></Grid>
                            <Border Background="{StaticResource BrushAccentSoft}" CornerRadius="10" Padding="16" HorizontalAlignment="Left" Margin="0,28,0,16">
                                <Path Data="{Binding SelectedArtifact.IconKey, Converter={x:Static local:IconKeyToGeometryConverter.Instance}}" Style="{StaticResource StudioIcon}" Stroke="{StaticResource BrushAccent}" Width="28" Height="28" /></Border>
                            <TextBlock Text="{Binding SelectedArtifact.FileName}" FontSize="20" TextWrapping="Wrap" FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedArtifact.TypeText}" Style="{StaticResource StudioCaption}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding SelectedArtifact.SizeText}" Style="{StaticResource StudioCaption}" />
                            <Button Style="{StaticResource StudioButton}" Content="安全预览" Click="OnPreviewArtifact" Margin="0,20,0,0" MinHeight="44" />
                            <Button Style="{StaticResource StudioPrimary}" Content="打开文件" Command="{Binding OpenArtifactCommand}" CommandParameter="{Binding SelectedArtifact}" Margin="0,28,0,8" />
                            <Button Style="{StaticResource StudioButton}" Content="打开所在目录" Command="{Binding RevealArtifactCommand}" CommandParameter="{Binding SelectedArtifact}" />
                            <Button Style="{StaticResource StudioButton}" Content="复制完整路径" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedArtifact}" />
                            <TextBlock Text="文件信息" Style="{StaticResource StudioCaption}" Margin="0,28,0,10" />
                            <TextBlock Text="相对路径" Style="{StaticResource StudioCaption}" />
                            <TextBox Text="{Binding SelectedArtifact.Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource InputBox}" Margin="0,5,0,18" />
                            <Expander Header="校验信息 · SHA-256" Style="{StaticResource StepsExpander}"><TextBox Text="{Binding SelectedArtifact.Sha256, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Style="{StaticResource InputBox}" /></Expander>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
