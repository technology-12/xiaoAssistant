{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiao OpenCode gateway run v1",
  "type": "object",
  "required": ["version", "taskId", "sessionId", "mode", "request", "system", "model", "tools"],
  "properties": {
    "version": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "sessionId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "mode": { "enum": ["Execute", "ReadOnly"] },
    "request": { "type": "string", "maxLength": 100000 },
    "system": { "type": "string", "maxLength": 200000 },
    "history": { "type": "array", "description": "Imported only when creating the upstream conversation; later turns reuse its native session." },
    "model": {
      "type": "object", "required": ["baseUrl", "modelName", "apiKey"],
      "properties": { "baseUrl": { "type": "string", "format": "uri" }, "modelName": { "type": "string", "maxLength": 128 }, "apiKey": { "type": "string" } }
    },
    "tools": {
      "type": "array", "maxItems": 32,
      "items": { "type": "object", "required": ["name", "description", "inputSchema"],
        "properties": { "name": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$" }, "description": { "type": "string" }, "inputSchema": { "type": "object", "properties": { "type": { "const": "object" } }, "required": ["type"] } } }
    }
  }
}
